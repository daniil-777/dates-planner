# ---------------------------------------------------------------------------
# Two-Way Match — environment template
#
# Copy to .env and fill in.  .env is git-ignored; .env.example never contains a
# real value.  Every variable the app reads is listed here — if you find one in
# the code that is not in this file, this file is the bug.
#
#   cp .env.example .env
#
# The app is designed to start and work with this file completely empty:
# no credentials  ->  Document AI runs in mock mode, the LLM falls back to the
# deterministic template provider, the classifier runs locally from
# ml/model/weights.json, and auth falls back to CAP's mocked users in dev.
# Every variable here buys you one more real service, none of them is required.
#
# Values with a "$" in them (bcrypt hashes!) must be single-quoted, otherwise
# some dotenv parsers try to expand them as shell variables.
# ---------------------------------------------------------------------------


# ===========================================================================
# 1. Runtime
# ===========================================================================

# HTTP port the CAP server listens on. 4004 is the CAP default and what the
# Vite dev proxy in app/vite.config.ts expects. Fly.io/CF override this.
PORT=4004

# 'development' (default) keeps mocked auth, verbose CAP logs and the local
# SQLite file. 'production' turns on basic auth, helmet, rate limiting and
# the built SPA served from the CAP process.
NODE_ENV=development


# ===========================================================================
# 2. LLM — "Statement of Us" generator          (docs/CONTRACTS.md §7)
# ===========================================================================
# Provider selection order, first one configured wins:
#   1. ANTHROPIC_API_KEY            -> native Anthropic SDK
#   2. LLM_BASE_URL + LLM_API_KEY   -> any OpenAI-compatible /chat/completions
#   3. AICORE_SERVICE_KEY           -> SAP generative AI hub
#   4. nothing                      -> deterministic template provider
# Option 4 is not a stub: it renders a complete statement from the aggregates.

# --- provider 1: Anthropic ---------------------------------------------------

# API key from console.anthropic.com -> API Keys. Starts with "sk-ant-".
# Its mere presence selects this provider. Leave empty to skip it.
ANTHROPIC_API_KEY=

# Model for provider 1. Falls back to LLM_MODEL, then to 'claude-opus-5'.
ANTHROPIC_MODEL=

# Override the Anthropic API base URL — for a proxy or a gateway. Almost always
# left empty.
ANTHROPIC_BASE_URL=

# --- provider 2: any OpenAI-compatible endpoint ------------------------------

# Base URL WITHOUT the trailing /chat/completions. Local Ollama:
# http://localhost:11434/v1 — vLLM, LM Studio and OpenRouter also fit here.
LLM_BASE_URL=

# Bearer token for LLM_BASE_URL. Ollama ignores the value, but BOTH this and
# LLM_BASE_URL must be non-empty before provider 2 is selected — so put any
# obvious dummy here for a local Ollama.
LLM_API_KEY=

# Model id. Used by provider 2 (which has no sensible default and will report a
# clear error if it is empty here) and as the fallback model name for providers
# 1 and 3. Ollama: e.g. 'llama3.1:8b'.
LLM_MODEL=

# --- provider 3: SAP generative AI hub (AI Core orchestration) ---------------

# The whole SAP AI Core service key as ONE line of JSON. BTP cockpit ->
# Instances and Subscriptions -> your AI Core instance -> Service Keys -> View.
# Must contain clientid, clientsecret, url and serviceurls.AI_API_URL, or the
# app falls through to the template provider and says so on the Settings page.
# Example shape (dummy values):
# AICORE_SERVICE_KEY={"serviceurls":{"AI_API_URL":"https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com"},"clientid":"sb-example!b1|aicore!b2","clientsecret":"dummy-not-a-real-secret","url":"https://example-trial.authentication.eu10.hana.ondemand.com"}
AICORE_SERVICE_KEY=

# Model deployed in the hub. Falls back to LLM_MODEL, then to
# 'anthropic--claude-4-sonnet'.
AICORE_MODEL=

# AI Core resource group holding the orchestration deployment. Default 'default'.
AICORE_RESOURCE_GROUP=default

# Pin one orchestration deployment instead of discovering the first RUNNING one
# in the resource group. Leave empty unless you have several.
AICORE_DEPLOYMENT_ID=


# ===========================================================================
# 3. SAP Document AI — receipt extraction       (docs/DOCUMENT_AI.md)
# ===========================================================================
# Mock mode is ON when MOCK_DOCAI is truthy *or* when any one of DOCAI_URL,
# DOCAI_UAA_URL, DOCAI_CLIENT_ID, DOCAI_CLIENT_SECRET is missing or blank.
# (DOCAI_SCHEMA_NAME and DOCAI_DOCUMENT_TYPE do NOT affect that decision.)
#
# The four credential lines below are left EMPTY on purpose: a fresh copy of this
# file must land in mock mode, not in a 401. The comments show the shape of each
# value so you can recognise it in the service key.

# Force the bundled fixtures even when credentials are present. Accepted truthy
# values: 1, true, yes, on (case-insensitive); anything else means live. Keep it
# on in CI and whenever you do not want to spend trial quota on a test scan.
MOCK_DOCAI=1

# Service key field: url
# Host of the Document AI API — no path; the client appends
# /document-information-extraction/v1/... itself (a trailing slash is stripped).
# e.g. https://aiservices-dox.cfapps.eu10.hana.ondemand.com
DOCAI_URL=

# Service key field: uaa.url
# XSUAA token host. The client POSTs to {DOCAI_UAA_URL}/oauth/token. This is the
# *authentication* host, not the API host — swapping the two is the single most
# common setup mistake and shows up as a 401.
# e.g. https://example-trial.authentication.eu10.hana.ondemand.com
DOCAI_UAA_URL=

# Service key field: uaa.clientid
# Shaped like sb-<name>!b<n> and dox-<name>!b<n> joined by a vertical bar. The
# bar and the exclamation marks are part of the value; quote it in a shell.
DOCAI_CLIENT_ID=

# Service key field: uaa.clientsecret
# NEVER commit this. Rotate by deleting and recreating the service key.
DOCAI_CLIENT_SECRET=

# Name of the custom extraction schema you created in the Document AI UI.
# Empty = use the built-in 'invoice' document type with an explicit header
# field list, which is good enough for most receipts. See docs/DOCUMENT_AI.md
# for the walkthrough that creates a 'receipt' schema.
DOCAI_SCHEMA_NAME=

# Document type sent with the job. 'invoice' is the built-in type used when no
# custom schema is configured; a custom schema brings its own type.
DOCAI_DOCUMENT_TYPE=invoice


# ===========================================================================
# 4. Remote classifier — optional             (docs/CONTRACTS.md §5, AI_CORE.md)
# ===========================================================================
# Unset (the default) = inference runs in-process from ml/model/weights.json.
# Set = the app POSTs {merchantRaw, amount, whenISO} to CLASSIFIER_URL and
# returns engine:'remote'. Any remote failure falls back to local inference with
# a logged warning (never the payload — it holds merchant names), so a stale
# token costs nothing but the 'remote' label on the result.

# Full URL of the prediction route, including the path the serving container
# exposes. ml/serve.py serves POST /classify, so: <deploymentUrl>/classify
# (or http://localhost:8088/classify for a local Python sidecar).
CLASSIFIER_URL=

# Sent as "Authorization: Bearer <token>" when set. For AI Core this is an
# XSUAA client-credentials token, which expires (~12 h) — see docs/AI_CORE.md
# for why a hard-coded token is a temporary arrangement.
CLASSIFIER_TOKEN=

# Sent as the "AI-Resource-Group" header when set. AI Core rejects /v2/lm and
# inference calls without it. On the free tier this is almost always 'default'.
CLASSIFIER_RESOURCE_GROUP=default


# ===========================================================================
# 5. Auth — production HTTP basic auth for the two seeded logins
# ===========================================================================
# Only used when NODE_ENV=production. In dev, CAP's mocked users are active.
# Generate a hash with:   npm run hash -- 'the password you chose'
# The usernames must match a People.email in the seed data, otherwise the
# request authenticates but no person row is found. The ledger itself has no
# limit on how many people it holds; these are the two that can sign in.

AUTH_USER_A=partner-a@example.com
AUTH_HASH_A='$2b$12$replace.this.with.the.output.of.npm.run.hash.0000000000'

AUTH_USER_B=partner-b@example.com
AUTH_HASH_B='$2b$12$replace.this.with.the.output.of.npm.run.hash.1111111111'

# ---------------------------------------------------------------------------
# Open door — ANY username, ANY password
# ---------------------------------------------------------------------------
# Set to 1 and the sign-in form accepts whatever is typed into it, with no AUTH_USER_*/
# AUTH_HASH_* pair needed. It exists so a link can be handed to somebody without issuing
# them a credential first.
#
# While it is on, everything in the ledger — every expense, every receipt photo, every
# memory — is readable and writable by anyone who knows the URL. There is no second gate.
# The server logs a warning naming this variable on every boot.
#
# Configured logins still take precedence, so a real credential resolves to its own slot
# and its own Person row; only what they reject falls through to the open door.
AUTH_ALLOW_ANY=

# ---------------------------------------------------------------------------
# Receipt extraction without a BTP account
# ---------------------------------------------------------------------------
# With no DOCAI_* credentials, the scanner falls back in this order:
#
#   1. ANTHROPIC_API_KEY set  -> Claude reads the photograph (srv/lib/documentai/
#      llm-extractor.ts). A real extraction; /health reports docai: "llm".
#   2. otherwise              -> bundled fixtures, chosen by FILE NAME. This is not an
#      extractor: a phone photo always returns the same sample receipt, so every scan
#      shows the same merchant and the same total. /health reports docai: "mock" and the
#      Scan page says so in red.
#
# ANTHROPIC_API_KEY is the same key the statement generator uses (section 6) — setting it
# once turns on both. Effort is `low` by default because the latency is spent standing at a
# till; raise it if you would rather wait than re-key a total.
ANTHROPIC_EXTRACT_EFFORT=


# ===========================================================================
# 6. SAP HANA Cloud — optional forecasting path   (docs/HANA_PAL.md)
# ===========================================================================
# All three must be set for the PAL forecaster to be attempted; otherwise the
# TypeScript Holt-Winters in srv/lib/forecast.ts is used, which is the default
# and stays the default. Requires @sap/hana-client, which is deliberately not
# a dependency of this project — see docs/HANA_PAL.md.

# Host:port from HANA Cloud Central -> your instance -> SQL Endpoint.
HANA_HOST=
# Database user. Do not use DBADMIN for the app; create TWM_APP instead.
HANA_USER=
# Password for HANA_USER.
HANA_PASSWORD=

# ── Sessions (login page) ────────────────────────────────────────────────
# Signs the twm_session cookie (HMAC-SHA256). Any long random string.
#   openssl rand -base64 32
# Without it the server generates a random key at boot, which means sessions do
# not survive a restart and do not span multiple instances. Set it in production.
SESSION_SECRET=
